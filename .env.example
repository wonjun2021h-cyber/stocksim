# ─────────────────────────────────────────────
# StockSim 환경변수 설정 예시
# 이 파일을 .env.local 로 복사하고 값을 채워주세요.
# ─────────────────────────────────────────────

# ── Supabase (로그인·포트폴리오 저장 필수) ─────
# 1) .env.example 을 복사:  cp .env.example .env.local
# 2) Supabase 대시보드 > Settings > API 에서 URL·anon key 복사
# 3) Authentication > URL Configuration 에 Redirect URL 추가:
#    http://localhost:3000/auth/callback
#    (휴대폰 테스트 시 http://<PC-IP>:3000/auth/callback 도 추가)
# 자세한 절차: docs/SUPABASE_AUTH_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google 로그인 (Supabase Providers에 넣은 Client ID와 동일, .apps.googleusercontent.com 로 끝남)
# 이 값이 있으면 "Unable to exchange external code" 우회 경로 사용
NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# 서버사이드 API 라우트 전용 (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Discord 웹훅 (선택) ──────────────────────
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx
# DISCORD_NOTIFY_SUCCESS=1
